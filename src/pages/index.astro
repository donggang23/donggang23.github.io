---
// 首页内容集中在这里，改文字即可，无需碰样式逻辑
const profile = {
  name: "东钢",
  role: "一人公司 · 数据 × 内容 × 自动化",
  tagline: "用数据和内容，把体育赛事与跨境生意跑通自动化。",
};

const directions = [
  {
    title: "体育赛事信息化",
    desc: "「浙江微体育」：覆盖 11 地市 / 90 区县 / 1365 镇街的赛事采集与定时推送系统。",
    tag: "采集 · 推送",
  },
  {
    title: "TikTok 电商数据与内容",
    desc: "CozyNestShop / Kalodata：马来市场选品分析、爆款短视频流水线量产。",
    tag: "出海 · 选品",
  },
  {
    title: "视频号内容制作",
    desc: "「戎耀运河」优秀老兵创业展播、「都婷好」访谈节目等多条内容线。",
    tag: "短视频 · 包装",
  },
  {
    title: "微信数据归档",
    desc: "聊天记录结构化归档与检索，把散落对话沉淀为可查资产。",
    tag: "归档 · 检索",
  },
];

const principles = [
  { k: "自动化优先", v: "能脚本化的不手工，重复劳动交给系统。" },
  { k: "结构化输出", v: "表格 / 图表 / 文档化交付，结论一眼可见。" },
  { k: "版本纪律", v: "每个产物带版本号，改动可追溯、可回滚。" },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="东钢的一人公司 · 体育赛事信息化 / TikTok 电商数据与内容 / 视频号制作 / 微信数据归档" />
    <title>{profile.name} · {profile.role}</title>
  </head>
  <body>
    <div class="bg"></div>
    <main>
      <header class="hero">
        <div class="avatar">东</div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
      </header>

      <section class="block">
        <h2>关于我</h2>
        <p class="lead">
          我是东钢，一个人运营的公司。专注把重复的信息工作自动化：从浙江 11 地市体育赛事的采集推送，
          到 TikTok 东南亚电商的数据分析与短视频量产，再到视频号内容制作。相信「零操作全自动」——
          能交给系统的，就不交给手。
        </p>
      </section>

      <section class="block">
        <h2>业务方向</h2>
        <div class="grid">
          {directions.map((d) => (
            <article class="card">
              <span class="card-tag">{d.tag}</span>
              <h3>{d.title}</h3>
              <p>{d.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="block">
        <h2>工作方式</h2>
        <ul class="principles">
          {principles.map((p) => (
            <li>
              <strong>{p.k}</strong>
              <span>{p.v}</span>
            </li>
          ))}
        </ul>
      </section>

      <footer>
        <span>© {new Date().getFullYear()} {profile.name} · 一人公司</span>
        <a href="https://github.com/donggang23" target="_blank" rel="noopener">GitHub</a>
      </footer>
    </main>

    <style>
      :root {
        --bg: #0d1117;
        --panel: #161b22;
        --line: #232a33;
        --text: #e6edf3;
        --muted: #9aa7b4;
        --accent: #f0883e;
        --accent2: #58a6ff;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.7;
        min-height: 100vh;
        position: relative;
      }
      .bg {
        position: fixed; inset: 0; z-index: -1;
        background:
          radial-gradient(900px 500px at 15% -10%, rgba(240,136,62,0.18), transparent 60%),
          radial-gradient(800px 500px at 100% 0%, rgba(88,166,255,0.14), transparent 55%);
      }
      main {
        max-width: 920px;
        margin: 0 auto;
        padding: 72px 24px 48px;
      }
      .hero { text-align: center; margin-bottom: 56px; }
      .avatar {
        width: 76px; height: 76px; margin: 0 auto 20px;
        display: grid; place-items: center;
        font-size: 34px; font-weight: 700;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--accent), #ff7a59);
        color: #1a1205;
        box-shadow: 0 10px 30px rgba(240,136,62,0.35);
      }
      h1 { font-size: 40px; letter-spacing: 2px; }
      .role { color: var(--accent); font-weight: 600; margin-top: 8px; letter-spacing: 1px; }
      .tagline { color: var(--muted); margin-top: 16px; font-size: 17px; }

      .block { margin-bottom: 48px; }
      h2 {
        font-size: 22px; margin-bottom: 18px;
        padding-left: 12px; border-left: 4px solid var(--accent);
      }
      .lead { color: #cdd6e0; font-size: 16px; }

      .grid {
        display: grid; gap: 16px;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 20px;
        transition: transform .2s ease, border-color .2s ease;
      }
      .card:hover { transform: translateY(-4px); border-color: var(--accent); }
      .card-tag {
        display: inline-block; font-size: 12px; color: var(--accent2);
        background: rgba(88,166,255,0.1); border: 1px solid rgba(88,166,255,0.25);
        padding: 2px 10px; border-radius: 999px; margin-bottom: 10px;
      }
      .card h3 { font-size: 18px; margin-bottom: 8px; }
      .card p { color: var(--muted); font-size: 14px; }

      .principles { list-style: none; display: grid; gap: 14px; }
      .principles li {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: 12px; padding: 14px 18px;
        display: flex; gap: 14px; align-items: baseline;
      }
      .principles strong {
        color: var(--accent); min-width: 96px; flex-shrink: 0;
      }
      .principles span { color: var(--muted); font-size: 15px; }

      footer {
        display: flex; justify-content: space-between; align-items: center;
        border-top: 1px solid var(--line); padding-top: 22px;
        color: var(--muted); font-size: 14px; flex-wrap: wrap; gap: 8px;
      }
      footer a { color: var(--accent2); text-decoration: none; }
      footer a:hover { text-decoration: underline; }

      @media (max-width: 560px) {
        h1 { font-size: 32px; }
        main { padding-top: 48px; }
        .principles li { flex-direction: column; gap: 4px; }
      }
    </style>
  </body>
</html>
